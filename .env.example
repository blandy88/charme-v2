# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Parfumerie Charme <your-email@gmail.com>

# JWT Secret — MUST be changed to a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Admin user creation (for init-database.js)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
