# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Parfumerie Charme <your-email@gmail.com>

# JWT Secret — MUST be changed to a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Admin user creation (for init-database.js)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# AI back-office assistant (admin-only chat that reads and acts on the shop).
# Any OpenAI-compatible endpoint works: OpenAI, Azure OpenAI / Azure AI Foundry,
# OpenRouter, Groq, Together, vLLM, LM Studio, Ollama. The model MUST support
# tool/function calling.
#
# These values are the DEFAULT. An administrator can also pick a provider
# (OpenAI, Azure, Anthropic, Gemini, OpenRouter, Groq, DeepSeek, Mistral, xAI,
# Together, Fireworks, Perplexity, Ollama, LM Studio, Pollinations or a custom
# endpoint) and paste its key in the assistant's own settings panel; that is
# stored in the database, encrypted, and wins over anything set here. Delete the
# saved settings in the panel to fall back to the values below.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional tuning
# AI_TIMEOUT_MS=120000
# AI_MAX_STEPS=8

# Database
# DATABASE_URL=postgresql://user:pass@host:5432/db  # set this for Postgres; otherwise SQLite at database/parfumerie.db is used
# SQLITE_PATH=database/parfumerie.db               # override the default SQLite file path

# Hosting (platform-provided on Render / Vercel)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
# VERCEL_URL=your-app.vercel.app

# Allow unverified logins during local development (not for production)
# ALLOW_UNVERIFIED_LOGIN=true

# Serve the React frontend from Express (set to 1 in production when not on a CDN)
# SERVE_REACT=1
