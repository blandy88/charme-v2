{
  "_comment": "The client trailer. Two segments because the theme and the signed-in account cannot change mid-film without a reload: trailer-shop (light, Léa) and trailer-admin (night, the owner). Shot against the isolated demo instance in demo/. Run: node render.cjs trailer-shop trailer.json --check, then without --check. Duration is driven by the narration, so the lines are the cut.",
  "_fields": {
    "frameFrom": "selectors that decide the camera only - a push-in with no dimming, for a trailer rather than a tutorial",
    "spotFrom": "selectors to cut a spotlight around; also sets the camera",
    "scrim": "0..1 strength of the spotlight scrim (1 = tutorial default)",
    "pad": "air around the framing box (0.2 = 20%)",
    "zmax": "hard ceiling on the push-in",
    "minFrame": "[w,h] floor on the framing box, for tiny targets like a button",
    "cursor": "park the pointer somewhere deliberate on a wide establishing shot",
    "do": "actions run before the beat is measured",
    "clickAtEnd": "seconds before the beat ends when the click lands",
    "clickOn": "click this element while the spotlight stays on spotFrom",
    "pageFadeIn/pageFadeOut": "dip to black for a route or modal change",
    "typeInto/typeText/typeDur": "type into a field, visibly, on the frame clock",
    "hold": "extra seconds of silence after the line, to let a shot breathe"
  },
